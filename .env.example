PORT=3000

# Kling VIDEO 3.0 official API
# The server creates the short-lived HS256 JWT from this access/secret pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingai.com
KLING_MODEL=kling-v3
KLING_TIMEOUT_MS=1200000
KLING_POLL_MS=6000

# Postgres (optional for credit/billing persistence)
DATABASE_URL=
