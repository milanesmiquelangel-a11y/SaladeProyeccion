PORT=3000

# ── MOTOR DE VIDEO GRATIS: WAN 2.2 (Hugging Face Spaces) ──
HF_TOKEN=
WAN_SPACE_ID=Upsampler/wan-2-2-5b-video
WAN_STEPS=4
WAN_GUIDE_SCALE=5
WAN_FRAMES=73
WAN_MODEL=Wan2.2

# ── MOTOR DE AUDIO GRATIS ──
MELO_COMMAND=melo
MELO_TIMEOUT_MS=120000
MELO_ES_SPEAKER=ES
MELO_EN_SPEAKER=EN-US

# ── EFECTOS DE SONIDO GRATIS ──
NATURAL_AUDIO_SPACE=stabilityai/stable-audio-3
NATURAL_AUDIO_STEPS=8
NATURAL_AUDIO_VARIANT=small-sfx

# ── Postgres (solo para facturacion; sin ella la app sigue generando) ──
DATABASE_URL=

# ── MOTOR DE PRODUCCION: KLING VIDEO 3.0 ──
# Required for quality text-to-video + native dialogue/audio.
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingai.com
KLING_MODEL=kling-v3
KLING_MODE=auto
KLING_TIMEOUT_MS=1200000
KLING_POLL_MS=6000
