PORT=3000
VIDEO_PROVIDER=wan2.2-free
# Optional Hugging Face token. Public ZeroGPU Spaces can work without it,
# but a token may improve access/rate limits when the Space requires auth.
HF_TOKEN=
# Optional: override the primary Space. Default is Upsampler/wan-2-2-5b-video.
WAN_SPACE_ID=Upsampler/wan-2-2-5b-video
# Optional: force a named Gradio endpoint after inspecting view_api().
WAN_ENDPOINT=
WAN_MODEL=Wan2.2
WAN_STEPS=20
WAN_GUIDE_SCALE=5
WAN_FRAMES=49
# PostgreSQL remains required for the credit/billing ledger.
DATABASE_URL=
